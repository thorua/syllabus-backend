# Copiar a .env (nunca subir .env al repositorio).

# Desarrollo: activa Mailpit (bandeja de correos de prueba). En producción, deje esta línea vacía.
COMPOSE_PROFILES=dev

# Puerto público del frontend (en producción, 8081 si un proxy HTTPS ocupa el 80)
FRONTEND_PORT=80

# Base de datos
POSTGRES_DB=syllabus
POSTGRES_USER=syllabus
POSTGRES_PASSWORD=cambie-esta-clave

# Migraciones: en desarrollo se cargan también los datos demo (db/demo).
# En producción usar solo: classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# JWT (mínimo 32 caracteres; genere uno con: openssl rand -base64 48)
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-de-48
JWT_EXPIRES_IN=8h

# Correo (Mailpit en desarrollo: bandeja en http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=syllabus@autonoma.edu.co
# Solo con un SMTP real (producción): usuario, contraseña y STARTTLS (true en Office 365, puerto 587)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=false

# URL pública del frontend (enlaces de recuperación de contraseña)
APP_URL=http://localhost

# Administrador inicial: se crea al arrancar si no existe
ADMIN_EMAIL=admin@autonoma.edu.co
ADMIN_PASSWORD=Uam2026!
